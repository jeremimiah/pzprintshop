generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum PricingType {
  FIXED
  QUOTATION
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PRODUCTION
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  GCASH
  BANK_TRANSFER
  MAYA
}

enum PaymentType {
  FULL
  PARTIAL
}

enum MovementType {
  IN
  OUT
  ADJUST
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String
  passwordHash   String
  role           Role                @default(STAFF)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdOrders  Order[]             @relation("CreatedBy")
  payments       Payment[]           @relation("RecordedBy")
  statusLogs     OrderStatusLog[]   @relation("ChangedBy")
  movements      InventoryMovement[] @relation("MovedBy")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Service {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String?
  pricingType    PricingType
  price          Int? // centavos; required if FIXED
  unit           String // page, piece, shirt, etc.
  turnaroundDays Int?
  fieldTemplate  String? // JSON array of custom field defs (stored as text in SQLite)
  active         Boolean     @default(true)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Order {
  id          String          @id @default(cuid())
  orderNo     String          @unique // ORD-YYYY-NNNN (year-prefixed)
  customer    Customer        @relation(fields: [customerId], references: [id])
  customerId  String
  status      OrderStatus     @default(PENDING_CONFIRMATION)
  dueDate     DateTime?
  totalAmount Int             @default(0) // centavos
  paidAmount  Int             @default(0) // centavos
  balance     Int             @default(0) // centavos
  notes       String?
  createdBy   User            @relation("CreatedBy", fields: [createdById], references: [id])
  createdById String
  items       OrderItem[]
  payments    Payment[]
  statusLogs  OrderStatusLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([dueDate])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String
  quantity  Int
  unitPrice Int // centavos
  subtotal  Int // centavos
  specs     String? // JSON object of custom-field values (+ free notes), stored as text
  notes     String?
}

model Payment {
  id          String        @id @default(cuid())
  order       Order         @relation(fields: [orderId], references: [id])
  orderId      String
  amount      Int // centavos
  method      PaymentMethod
  type        PaymentType
  paidAt      DateTime      @default(now())
  receiptNo   String?
  recordedBy  User          @relation("RecordedBy", fields: [recordedById], references: [id])
  recordedById String
  note        String?
}

model OrderStatusLog {
  id          String      @id @default(cuid())
  order       Order       @relation(fields: [orderId], references: [id])
  orderId     String
  from        OrderStatus?
  to          OrderStatus
  changedBy   User        @relation("ChangedBy", fields: [changedById], references: [id])
  changedById String
  note        String?
  createdAt   DateTime    @default(now())
}

model InventoryItem {
  id        String              @id @default(cuid())
  name      String
  category  String
  unit      String
  stock     Int                 @default(0) // whole units
  minStock  Int?
  notes     String?
  movements InventoryMovement[]
  updatedAt DateTime            @updatedAt
  createdAt DateTime            @default(now())
}

model InventoryMovement {
  id          String          @id @default(cuid())
  item        InventoryItem   @relation(fields: [itemId], references: [id])
  itemId      String
  type        MovementType
  quantity    Int // whole units
  note        String?
  orderId     String?
  createdAt   DateTime        @default(now())
  createdBy   User            @relation("MovedBy", fields: [createdById], references: [id])
  createdById String
}
